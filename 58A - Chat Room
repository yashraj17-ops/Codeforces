    cin >> s;

    string c = "hello";
    int j = 0;

    for(int i = 0; i < s.size(); i++)
    {
        if(s[i] == c[j])
        {
            j++;
        }

        if(j == 5)
        {
            cout << "YES";
            return 0;
        }
    }

    cout << "NO";
}
