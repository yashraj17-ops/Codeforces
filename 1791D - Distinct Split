#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        vector<int> left(26, 0);
        vector<int> right(26, 0);

        // Initially, everything is in the right part
        for (char c : s) {
            right[c - 'a']++;
        }

        int distinctLeft = 0;
        int distinctRight = 0;

        // Count distinct characters in right
        for (int i = 0; i < 26; i++) {
            if (right[i] > 0) {
                distinctRight++;
            }
        }

        int ans = 0;

        // Try every possible split
        for (int i = 0; i < n - 1; i++) {

            int x = s[i] - 'a';

            // Move s[i] from right to left
            left[x]++;
            right[x]--;

            // First occurrence in left
            if (left[x] == 1) {
                distinctLeft++;
            }

            // No occurrence remaining in right
            if (right[x] == 0) {
                distinctRight--;
            }

            ans = max(ans, distinctLeft + distinctRight);
        }

        cout << ans << '\n';
    }

    return 0;
}
