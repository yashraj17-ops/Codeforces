#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int n = s.size();

        vector<int> left(26, 0);
        vector<int> right(26, 0);

        // Initially, everything is on the right
        for (char c : s) {
            right[c - 'a']++;
        }

        int distinctLeft = 0;
        int distinctRight = 0;

        // Count distinct characters in the whole string
        for (int i = 0; i < 26; i++) {
            if (right[i] > 0) {
                distinctRight++;
            }
        }

        int ans = 0;

        // Split after s[i]
        for (int i = 0; i < n - 1; i++) {

            int x = s[i] - 'a';

            // Move character from right to left
            right[x]--;
            left[x]++;

            // It is appearing for the first time in left
            if (left[x] == 1) {
                distinctLeft++;
            }

            // It has completely disappeared from right
            if (right[x] == 0) {
                distinctRight--;
            }

            ans = max(ans, distinctLeft + distinctRight);
        }

        cout << ans << '\n';
    }

    return 0;
}
