#include <iostream>
using namespace std;

int main() {

    int n;
    cin >> n;

    string s[n];

    for(int i = 0; i < n; i++)
        cin >> s[i];

    int groups = 1;

    for(int i = 1; i < n; i++) {

        if(s[i] != s[i - 1])
            groups++;
    }

    cout << groups;

    return 0;
}
