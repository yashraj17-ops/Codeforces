#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long n;
        cin >> n;

        int count2 = 0;
        int count3 = 0;

        while (n % 2 == 0) {
            count2++;
            n /= 2;
        }

        while (n % 3 == 0) {
            count3++;
            n /= 3;
        }

        if (n != 1) {
            cout << -1 << '\n';
        }
        else if (count2 > count3) {
            cout << -1 << '\n';
        }
        else {
            cout << 2 * count3 - count2 << '\n';
        }
    }

    return 0;
}
