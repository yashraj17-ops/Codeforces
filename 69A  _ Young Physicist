#include<iostream>
using namespace std;
    int main()

    {
        int n;
        cin>>n;
        int a[n][3],sum[3]={0};
        for(int i=0;i<n;i++){
            for(int j=0;j<3;j++){
                cin>>a[i][j];
            }
        }
        
        for(int i=0;i<n;i++){
            for(int j=0;j<3;j++){
                sum[j]+=a[i][j];
            }
        }
        
           if(sum[0]!=0 || sum[1]!=0 || sum[2]!=0){
               cout<<"NO";
           }
           else{
               cout<<"YES";
           }
        }
    
