#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[n];

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int maxPos = 0;
    int minPos = 0;

    for (int i = 1; i < n; i++) {
        if (a[i] > a[maxPos])
            maxPos = i;

        if (a[i] <= a[minPos])
            minPos = i;
    }

    int ans = maxPos + (n - 1 - minPos);

    if (maxPos > minPos)
        ans--;

    cout << ans;

    return 0;
}
