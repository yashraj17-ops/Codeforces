#include <iostream>
#include <vector>
using namespace std;

int main()
{
    int n, count = 1;
    cin >> n;

    vector<int> v(n);

    for(int i = 0; i < n; i++)
    {
        cin >> v[i];
    }

    int count1 = 1;

    for(int j = 1; j < n; j++)
    {
        if(v[j] >= v[j-1])
        {
            count1++;

            if(count1 > count)
            {
                count = count1;
            }
        }
        else
        {
            count1 = 1;
        }
    }

    cout << count;
}
