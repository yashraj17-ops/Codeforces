#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    int a[m];

    for (int i = 0; i < m; i++) {
        cin >> a[i];
    }

    sort(a, a + m);

    int min_diff = a[n - 1] - a[0];

    for (int i = 1; i <= m - n; i++) {
        min_diff = min(min_diff, a[i + n - 1] - a[i]);
    }

    cout << min_diff << endl;

    return 0;
}
