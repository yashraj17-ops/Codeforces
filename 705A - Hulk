#include <iostream>
using namespace std;

string feelings(int n) {
    if (n == 1)
        return "I hate";

    if (n % 2 == 0)
        return feelings(n - 1) + " that I love";
    else
        return feelings(n - 1) + " that I hate";
}

int main() {
    int n;
    cin >> n;

    cout << feelings(n) << " it";

    return 0;
}
